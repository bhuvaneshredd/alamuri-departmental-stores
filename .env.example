# Root Environment Template
NODE_ENV=development

# Server URL & Client URL
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quickstore?schema=public

# JWT Authentication
JWT_SECRET=quickstore_super_secret_jwt_key_development_only_change_in_production
JWT_EXPIRES_IN=7d

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_SAMPLEKEYID123
RAZORPAY_KEY_SECRET=SAMPLE_RAZORPAY_SECRET_KEY

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=sample_cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=sample_cloudinary_secret

# Google Maps / Geolocation
GOOGLE_MAPS_API_KEY=sample_google_maps_api_key

# Default Admin Credentials
ADMIN_INITIAL_EMAIL=admin@quickstore.com
ADMIN_INITIAL_PASSWORD=Admin@123456
